# Copy to backend/.env to override. Every setting is prefixed with DMP_.

# Where the SQLite database and the data product git repositories live.
# DMP_DATA_DIR=/var/lib/dmp
# DMP_DATABASE_URL=postgresql+psycopg://dmp:dmp@localhost/dmp

# Change this in any deployment that is not your laptop.
# DMP_SECRET_KEY=please-change-me
# DMP_ACCESS_TOKEN_TTL_MINUTES=720

# Identity of the mesh: the URN namespace and the environments products deploy to.
# DMP_URN_NAMESPACE=dmp
# DMP_ENVIRONMENTS=["development","qa","production"]
# DMP_MARKETPLACE_GATE_ENVIRONMENT=production

# Extra browser origins allowed to call the API.
# DMP_CORS_ORIGINS=["http://localhost:5173"]

# --- GitHub ------------------------------------------------------------
# With a token set, every scaffolded data product creates a REAL repository on
# GitHub and all descriptor commits and release tags are pushed there.
# Classic PAT: scopes `repo` (+ `delete_repo` if the platform should be able
# to delete repositories). Fine-grained: Administration + Contents read/write.
# The plain GITHUB_TOKEN variable is honoured as a fallback.
# DMP_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# User or organisation to create the repositories under (default: token user).
# DMP_GITHUB_OWNER=my-org
# DMP_GITHUB_REPO_PREFIX=dmp-
# DMP_GITHUB_REPOS_PRIVATE=true
# GitHub Enterprise: point at its API root.
# DMP_GITHUB_API_URL=https://github.my-company.com/api/v3
