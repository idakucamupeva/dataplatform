# Copy to backend/.env to override. Every setting is prefixed with DMP_.

# Where the SQLite database and the data product git repositories live.
# DMP_DATA_DIR=/var/lib/dmp
# DMP_DATABASE_URL=postgresql+psycopg://dmp:dmp@localhost/dmp

# Change this in any deployment that is not your laptop.
# DMP_SECRET_KEY=please-change-me
# DMP_ACCESS_TOKEN_TTL_MINUTES=720

# Identity of the mesh: the URN namespace and the environments products deploy to.
# DMP_URN_NAMESPACE=dmp
# DMP_ENVIRONMENTS=["development","qa","production"]
# DMP_MARKETPLACE_GATE_ENVIRONMENT=production

# Extra browser origins allowed to call the API.
# DMP_CORS_ORIGINS=["http://localhost:5173"]
